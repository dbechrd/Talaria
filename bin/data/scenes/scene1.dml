ta_camera:
  uid: "camera_player"
  position: { x: 0.0, y: 1.7, z: 24.0 }
  target_vel: 0.2
  target_smooth: 0.1
  yaw: 90.0
  yaw_smooth: 0.7
  pitch: 0.0
  pitch_min: -75.0
  pitch_max: 75.0
  pitch_smooth: 0.7
ta_texture:
  uid: "texture_1"
  path: "data/texture/genesis_1024_1024.png"
ta_shader:
  uid: "shader_lines"
  path_vert: "data/shader/lines_v.glsl"
  path_frag: "data/shader/lines_f.glsl"
  attributes:
  [
    { name: "attr_position", type: "vec3" },
    { name: "attr_color",    type: "vec4" }
  ]
  uniforms: [
    { name: "u_proj",  type: "mat4" },
    { name: "u_view",  type: "mat4" },
    { name: "u_model", type: "mat4" }
  ]
ta_shader:
  uid: "shader_quads"
  path_vert: "data/shader/quads_v.glsl"
  path_frag: "data/shader/quads_f.glsl"
  attributes:
  [
    { name: "attr_position", type: "vec3" },
    { name: "attr_color",    type: "vec4" },
    { name: "attr_uv",       type: "vec2" }
  ]
  uniforms: [
    { name: "u_proj",  type: "mat4" },
    { name: "u_view",  type: "mat4" },
    { name: "u_model", type: "mat4" },
    { name: "u_tex0",  type: "sampler2D" }
  ]
ta_shader:
  uid: "shader_mesh"
  path_vert: "data/shader/mesh_v.glsl"
  path_frag: "data/shader/mesh_f.glsl"
  attributes:
  [
    { name: "attr_position", type: "vec3" },
    { name: "attr_color",    type: "vec4" },
    { name: "attr_uv",       type: "vec2" },
    { name: "attr_normal",   type: "vec3" }
  ]
  uniforms: [
    { name: "u_proj",  type: "mat4" },
    { name: "u_view",  type: "mat4" },
    { name: "u_model", type: "mat4" },
    { name: "u_tex0",  type: "sampler2D" }
  ]
ta_material:
  uid: "material_1"
  shader_uid: "shader_mesh"
  texture_uid: "texture_1"
ta_mesh_group:
  uid: "mesh_group_chamber_0001"
  path: "data/models/Chamber0001.obj"
ta_sun_light:
  uid: "light_sun"
  direction: { x: 1.0, y: 2.0, z: 3.0 }
  color:     { r: 1.0, g: 2.0, b: 3.0 }
ta_point_light:
  uid: "light_1"
  position: { x: 1.0, y: 2.0, z: 3.0 }
  color:    { r: 1.0, g: 2.0, b: 3.0 }
ta_entity:
  uid: "entity_player"
  rigid_body_uid: "entity_player_aabb"
ta_entity:
  uid: "entity_chamber_0001"
  material_uid: "material_1"
  mesh_group_uid: "mesh_group_chamber_0001"
  transform:
    position: { x: 0.0, y: 0.0, z: 0.0 }
    rotation: { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    scale:    { x: 1.0, y: 1.0, z: 1.0 }
ta_rigid_body:
  uid: "entity_player_aabb"
  transform:
    position: { x: 0.0, y: 0.0, z: 0.0 }
    rotation: { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    scale:    { x: 1.0, y: 1.0, z: 1.0 }
  collider:
    type: 0  # TA_COLLIDER_AABB
    aabb:
      center:  { x: 0.0, y: 0.0, z: 0.0 }
      extents: { x: 1.0, y: 1.0, z: 1.0 }
ta_rigid_body:
  uid: "entity_player_obb"
  transform:
    position: { x: 0.0, y: 0.0, z: 0.0 }
    rotation: { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    scale:    { x: 1.0, y: 1.0, z: 1.0 }
  collider:
    type: 1  # TA_COLLIDER_OBB
    obb:
      center:  { x: 0.0, y: 0.0, z: 0.0 }
      extents: { x: 1.0, y: 1.0, z: 1.0 }
      axes: [
        { x: 1.0, y: 0.0, z: 0.0 },
        { x: 0.0, y: 1.0, z: 0.0 },
        { x: 0.0, y: 0.0, z: 1.0 }
      ]
