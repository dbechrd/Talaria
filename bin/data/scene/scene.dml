  path: "data/mesh/star.obj"
#-------------------------------------------------------------------------------
# TYP_MESH
#-------------------------------------------------------------------------------
#
# NOTE: We may have mesh properties at some point, but, for now, meshes are
# created at run-time via mesh_groups.
#
#-------------------------------------------------------------------------------
# TYP_SHADER
#-------------------------------------------------------------------------------
ta_shader:
  name: "lines"
  path_vert: "data/shader/lines_v.glsl"
  path_frag: "data/shader/lines_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_color",
      type: 6,  # TA_GLSL_VEC4
    },
  ]
  uniforms: [
    {
      name: "u_proj",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_view",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_model",
      type: 8,  # TA_GLSL_MAT4
    },
  ]
ta_shader:
  name: "quads"
  path_vert: "data/shader/quads_v.glsl"
  path_frag: "data/shader/quads_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_color",
