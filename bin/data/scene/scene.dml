#-------------------------------------------------------------------------------
# TYP_SHADER
#-------------------------------------------------------------------------------
ta_shader:
  name: "lines"
  path_vert: "data/shader/lines_v.glsl"
  path_frag: "data/shader/lines_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_color",
      type: 6,  # TA_GLSL_VEC4
    },
  ]
  uniforms: [
    {
      name: "u_proj",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_view",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_model",
      type: 8,  # TA_GLSL_MAT4
    },
  ]
ta_shader:
  name: "quads"
  path_vert: "data/shader/quads_v.glsl"
  path_frag: "data/shader/quads_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_color",
      type: 6,  # TA_GLSL_VEC4
    },
    {
      name: "attr_uv",
      type: 4,  # TA_GLSL_VEC2
    },
  ]
  uniforms: [
    {
      name: "u_proj",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_view",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_model",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_tex",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
  ]
ta_shader:
  name: "text"
  path_vert: "data/shader/text_v.glsl"
  path_frag: "data/shader/text_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_color",
      type: 6,  # TA_GLSL_VEC4
    },
    {
      name: "attr_uv",
      type: 4,  # TA_GLSL_VEC2
    },
  ]
  uniforms: [
    {
      name: "u_proj",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_view",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_model",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_tex",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
  ]
ta_shader:
  name: "cubemap"
  path_vert: "data/shader/cubemap_v.glsl"
  path_frag: "data/shader/cubemap_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_uv",
      type: 4,  # TA_GLSL_VEC2
    },
  ]
  uniforms: [
    {
      name: "u_proj",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_view",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_model",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_face",
      type: 0,  # TA_GLSL_INT
    },
    {
      name: "u_tex",
      type: 10,  # TA_GLSL_SAMPLER_CUBE
    },
  ]
ta_shader:
  name: "mesh"
  path_vert: "data/shader/mesh_v.glsl"
  path_frag: "data/shader/mesh_f.glsl"
  attributes: [
    {
      name: "attr_position",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_color",
      type: 6,  # TA_GLSL_VEC4
    },
    {
      name: "attr_uv",
      type: 4,  # TA_GLSL_VEC2
    },
    {
      name: "attr_normal",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "attr_tangent",
      type: 5,  # TA_GLSL_VEC3
    },
  ]
  uniforms: [
    {
      name: "u_proj",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_view",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_model",
      type: 8,  # TA_GLSL_MAT4
    },
    {
      name: "u_camera_pos",
      type: 5,  # TA_GLSL_VEC3
    },
    {
      name: "u_material",
      type: 9,  # TA_GLSL_STRUCT
      properties: [
        {
          name: "u_material.tex0",
          type: 3,  # TA_GLSL_SAMPLER2D
        },
        {
          name: "u_material.tex1",
          type: 3,  # TA_GLSL_SAMPLER2D
        },
        {
          name: "u_material.tex2",
          type: 3,  # TA_GLSL_SAMPLER2D
        },
      ]
    },
    {
      name: "u_tex_albedo",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
    {
      name: "u_tex_height",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
    {
      name: "u_tex_metallic",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
    {
      name: "u_tex_normal",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
    {
      name: "u_tex_occlusion",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
    {
      name: "u_tex_roughness",
      type: 3,  # TA_GLSL_SAMPLER2D
    },
    {
      name: "u_lights_count",
