#-------------------------------------------------------------------------------
# TYP_FONT
#-------------------------------------------------------------------------------
ta_font:
  name: "ubuntumono"
  path: "data/font/UbuntuMono-Regular.ttf"
  pixel_height: 16.0
  shader: "text"
ta_font:
  name: "lexenddeca"
  path: "data/font/LexendDeca-Regular.ttf"
  pixel_height: 0x41900000 (18.000000)
  shader: "text"
#-------------------------------------------------------------------------------
# TYP_MATERIAL
#-------------------------------------------------------------------------------
ta_material:
  name: "red"
  shader: "mesh"
  tex_albedo: "red_albedo"
ta_material:
  name: "test"
  shader: "mesh"
  tex_albedo: "white_albedo"
ta_material:
  name: "cobble"
  shader: "mesh"
  tex_albedo: "cobble_albedo"
  tex_normal: "cobble_normal"
  tex_occlusion: "cobble_occlusion"
  tex_roughness: "cobble_roughness"
ta_material:
  name: "terrazzo"
  shader: "mesh"
  tex_albedo: "terrazzo_albedo"
  tex_height: "terrazzo_height"
  tex_normal: "terrazzo_normal"
  tex_occlusion: "terrazzo_occlusion"
  tex_roughness: "terrazzo_roughness"
ta_material:
  name: "metal_plate_019"
  shader: "mesh"
  tex_albedo: "metal_plate_019_albedo"
  tex_height: "metal_plate_019_height"
  tex_metallic: "metal_plate_019_metallic"
