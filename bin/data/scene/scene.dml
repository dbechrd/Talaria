  name: "gun"
  entity: "gun"
  carrying_ammo: 20
  carrying_ammo_max: 20
  loaded_ammo: 5
  loaded_ammo_max: 8
  sfx_bang: "sfx_gunshot"
  sfx_reload: "sfx_cock"
  sfx_empty: "sfx_oh_no"
#-------------------------------------------------------------------------------
# TYP_LIGHT
#-------------------------------------------------------------------------------
ta_light:
  name: "light_sun"
  entity: "light_sun"
  intensity: 0x409FFFFF (5.000000)
  color:
    r: 0x3ED70A3C (0.420000)
    g: 0x3F2B8521 (0.670000)
    b: 0x3F800000 (1.000000)
  type: 1  # TA_LIGHT_DIRECTIONAL
  directional:
    no_shadow_cast: false
    shadow_properties:
      shader: "shadow_dir"
      resolution: 8192
      znear: 0xC2200000 (-40.000000)
      zfar: 0x42200000 (40.000000)
