ta_camera:
  uid: "camera_player"
  mode: 1  # TA_CAMERA_FPS
  position: { x: 0.0, y: 1.7, z: 24.0 }
  position_smooth: 0.05
  position_target_vel: 0.2
  yaw: 90.0
  yaw_smooth: 0.7
  pitch: 0.0
  pitch_smooth: 0.7
  pitch_min: -75.0
  pitch_max: 75.0
  fov: 65.0
  nearz: 0.1
ta_camera:
  uid: "camera_freecam"
  mode: 0  # TA_CAMERA_FREECAM
  position: { x: 0.0, y: 10.0, z: 10.0 }
  position_smooth: 0.1
  position_target_vel: 0.2
  yaw: 90.0
  yaw_smooth: 0.7
  pitch: -45.0
  pitch_smooth: 0.7
  pitch_min: -90.0
  pitch_max: 90.0
  fov: 65.0
  nearz: 0.1
ta_texture:
  uid: "texture_1"
  path: "data/texture/genesis_1024_1024.png"
ta_shader:
  uid: "shader_lines"
  path_vert: "data/shader/lines_v.glsl"
  path_frag: "data/shader/lines_f.glsl"
  attributes: [
    { name: "attr_position", type: 4 },  # TA_GLSL_VEC3
    { name: "attr_color",    type: 5 },  # TA_GLSL_VEC4
  ]
  uniforms: [
    { name: "u_proj",  type: 7 },  # TA_GLSL_MAT4
    { name: "u_view",  type: 7 },  # TA_GLSL_MAT4
    { name: "u_model", type: 7 },  # TA_GLSL_MAT4
  ]
ta_shader:
  uid: "shader_quads"
  path_vert: "data/shader/quads_v.glsl"
  path_frag: "data/shader/quads_f.glsl"
  attributes: [
    { name: "attr_position", type: 4 },  # TA_GLSL_VEC3
    { name: "attr_color",    type: 5 },  # TA_GLSL_VEC4
    { name: "attr_uv",       type: 3 },  # TA_GLSL_VEC2
  ]
  uniforms: [
    { name: "u_proj",  type: 7 },  # TA_GLSL_MAT4
    { name: "u_view",  type: 7 },  # TA_GLSL_MAT4
    { name: "u_model", type: 7 },  # TA_GLSL_MAT4
    { name: "u_tex0",  type: 2 },  # TA_GLSL_SAMPLER2D
  ]
ta_shader:
  uid: "shader_mesh"
  path_vert: "data/shader/mesh_v.glsl"
  path_frag: "data/shader/mesh_f.glsl"
  attributes: [
    { name: "attr_position", type: 4 },  # TA_GLSL_VEC3
    { name: "attr_color",    type: 5 },  # TA_GLSL_VEC4
    { name: "attr_uv",       type: 3 },  # TA_GLSL_VEC2
    { name: "attr_normal",   type: 4 },  # TA_GLSL_VEC3
  ]
  uniforms: [
    { name: "u_proj",     type: 7 },  # TA_GLSL_MAT4
    { name: "u_view",     type: 7 },  # TA_GLSL_MAT4
    { name: "u_model",    type: 7 },  # TA_GLSL_MAT4
    { name: "u_sun",      type: 8,  # TA_GLSL_STRUCT
      properties: [
        { name: "u_sun.type",      type: 0 },  # TA_GLSL_GLINT
        { name: "u_sun.position",  type: 4 },  # TA_GLSL_VEC3
        { name: "u_sun.direction", type: 4 },  # TA_GLSL_VEC3
        { name: "u_sun.color",     type: 4 },  # TA_GLSL_VEC3
      ]
    },
    { name: "u_camera_pos", type: 4 },  # TA_GLSL_VEC3
    { name: "u_tex0", type: 2 }  # TA_GLSL_SAMPLER2D
  ]
ta_material:
  uid: "material_1"
  shader_uid: "shader_mesh"
  texture_uid: "texture_1"
ta_mesh_group:
  uid: "mesh_group_prim_cube"
  path: "data/mesh/prim_cube.obj"
ta_mesh_group:
  uid: "mesh_group_prim_sphere"
  path: "data/mesh/prim_sphere.obj"
ta_mesh_group:
  uid: "mesh_group_chamber_0001"
  path: "data/model/Chamber0001.obj"
ta_light:
  uid: "light_sun"
  type: 0  # TA_LIGHT_SUN
  sun:
    direction: { x: -1.0, y: -1.0, z: -1.0 }
    color:     { r: 1.0, g: 1.0, b: 1.0 }
ta_light:
  uid: "light_1"
  type: 1  # TA_LIGHT_POINT
  point:
    position: { x: 1.0, y: 2.0, z: 3.0 }
    color:    { r: 1.0, g: 2.0, b: 3.0 }
ta_rigid_body:
  uid: "rb_entity_chamber_0001"
  position: { x: 0.0, y: 0.0, z: 1.0 }
  collider:
    type: 0  # TA_COLLIDER_PLANE
    plane:
      center: { x: 0.0, y: 0.0, z: 0.0 }
      normal: { x: 0.0, y: 1.0, z: 0.0 }
  mass: 0.0
ta_rigid_body:
  uid: "tb_entity_chamber_right"
  collider:
    type: 0  # TA_COLLIDER_PLANE
    plane:
      center: { x: 6.0, y: 0.0, z: 0.0 }
      normal: { x: -1.0, y: 0.0, z: 0.0 }
  mass: 0.0
ta_rigid_body:
  uid: "tb_entity_chamber_left"
  collider:
    type: 0  # TA_COLLIDER_PLANE
    plane:
      center: { x: -6.0, y: 0.0, z: 0.0 }
      normal: { x: 1.0, y: 0.0, z: 0.0 }
  mass: 0.0
ta_rigid_body:
  uid: "tb_entity_chamber_far"
  collider:
    type: 0  # TA_COLLIDER_PLANE
    plane:
      center: { x: 0.0, y: 0.0, z: 6.0 }
      normal: { x: 0.0, y: 0.0, z: -1.0 }
  mass: 0.0
ta_rigid_body:
  uid: "tb_entity_chamber_near"
  collider:
    type: 0  # TA_COLLIDER_PLANE
    plane:
      center: { x: 0.0, y: 0.0, z: -6.0 }
      normal: { x: 0.0, y: 0.0, z: 1.0 }
  mass: 0.0
ta_entity:
  uid: "entity_chamber_0001"
  material_uid: "material_1"
  mesh_group_uid: "mesh_group_chamber_0001"
  rigid_body_uid: "rb_entity_chamber_0001"
  invisible: 0
ta_rigid_body:
  uid: "rb_entity_player"
  mass: 1.0
  position: { x: 0.1, y: 3.0, z: 0.1 }
ta_entity:
  uid: "entity_player"
  mesh_group_uid: "mesh_group_prim_sphere"
  rigid_body_uid: "rb_entity_player"
ta_rigid_body:
  uid: "rb_entity_sphere1"
  mass: 1.0
  position: { x: 0.2, y: 6.0, z: 0.2 }
ta_entity:
  uid: "entity_sphere1"
  mesh_group_uid: "mesh_group_prim_sphere"
  rigid_body_uid: "rb_entity_sphere1"
ta_rigid_body:
  uid: "rb_entity_sphere2"
  mass: 1.0
  position: { x: 0.3, y: 9.0, z: 0.3 }
ta_entity:
  uid: "entity_sphere2"
  mesh_group_uid: "mesh_group_prim_sphere"
  rigid_body_uid: "rb_entity_sphere2"
