{
	Color (attrib = "light") {float[3] {{0x3f800000, 0x3f800000, 0x3f800000}}}
	Param (attrib = "intensity") {float {0x447a0000}}

	Atten (curve = "inverse_square")
	{
		Param (attrib = "scale") {float {0x40af456b}}
	}
}

CameraObject $camera1		// camera
{
	Param (attrib = "fov") {float {0x3f30ecaa}}
	Param (attrib = "near") {float {0x3dcccccd}}
	Param (attrib = "far") {float {0x42c80000}}
}

